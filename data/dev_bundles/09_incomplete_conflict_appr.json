    "version": "1.0",
    "function_name": "route_ticket",
    "code": "def route_ticket(ticket):\n    if ticket.get('category') is None:\n        return 'manual_review'\n    if ticket.get('urgent') == True:\n        return 'priority_queue'\n    if ticket.get('wait_seconds') >= 1500:\n        return 'escalation'\n    return 'normal_queue'\n",
